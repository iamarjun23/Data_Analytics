# Set these as environment variables (or keep them in a local .env, which is never committed).
# In CI these come from the repository's secret store.

# SQLite file for project 3 (default: data/p3.db)
P3_DB=data/p3.db

# Salt for hashing phone/email in staging. Use a long random value; keep it secret.
PII_SALT=change-me

# Optional: inject schema drift into the mock API, e.g. rename:ticketing.channel>channel_name
MOCK_DRIFT=

# A real source would add a READ-ONLY API token here (the mock API needs none):
# SOURCE_API_TOKEN=
